# Production: set these in Netlify > Project configuration > Environment variables.
# Keep credentials in Netlify, not in a NEXT_PUBLIC variable or a Git repository.
# Netlify supplies its primary site URL automatically. Optional override:
# APP_URL=https://your-real-domain.example
APP_URL=
# Public configuration: do not mark AUTH_STORAGE as containing secret values.
AUTH_STORAGE=netlify

# Required only when the private account store is empty. Use a salted scrypt
# hash with N=32768, r=8, p=3; never commit a real hash or plaintext password.
AUTH_INITIAL_PASSWORD_HASH=

# Example Gmail sender. SMTP_PASSWORD must be an app password for this sender,
# NOT your Dream Sourcing sign-in password. Another SMTP provider also works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rabbikhan11002299@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Dream Sourcing <rabbikhan11002299@gmail.com>

# Local development only: copy to .env.local and use:
# APP_URL=http://localhost:3000
# AUTH_STORAGE=local
# AUTH_TEST_OUTBOX=.auth-data/outbox
